{
    "name": "esfahanahan/phpstan-rules",
    "description": "Custom PHPStan rules and extensions for EsfahanAhan.",
    "type": "phpstan-extension",
    "license": "MIT",
    "keywords": [
        "phpstan",
        "phpstan-extension",
        "static analysis",
        "laravel",
        "eloquent"
    ],
    "authors": [
        {
            "name": "EsfahanAhan",
            "email": "dev@esfahanahan.com",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.4",
        "phpstan/phpstan": "^2.1"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "EsfahanAhan\\PHPStan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EsfahanAhan\\PHPStan\\Tests\\": "tests/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "format": "pint",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
